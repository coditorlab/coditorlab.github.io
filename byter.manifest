{
    "name": "CODITORLAB",
    "short_name": "CODITOR",
    "description": "Comprehensive Utility & Networking Software Development Kit Management & Maintenance Tool",
    "start_url": "/",
    "scope": "/",
    "protocol_handlers": [
      {
        "protocol": "web+bow",
        "url": ".ott/bow/%s"
      },{
        "protocol": "web+otsl",
        "url": ".ott/otsl/%s"
      }
    ],
    "serviceworker": {
      "src": "./sw.js",
      "scope": "/",
      "update_via_cache": "ott.coditorlab."
    },
    "icons": [
      {
        "src": "https://avatars.githubusercontent.com/u/137660651",
        "sizes": "195x195",
        "type": "image/png"
      }
    ],
    "display": "fullscreen",
    "orientation": "portrait",
    "lang": "en",
    "theme_color": "#198754",
    "background_color": "#0f0f0f"
  }
